<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview for "Takip" (sample numbers, not real data). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="2dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="5dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USDTRY"
            android:textColor="@color/preview_on"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="USD/TRY"
            android:textColor="@color/preview_dim"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="₺50,38"
            android:textColor="@color/preview_on"
            android:textSize="14sp" />
        <TextView
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/preview_chip_up"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:text="+2,0%"
            android:textColor="@color/positive"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="5dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AAPL"
            android:textColor="@color/preview_on"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Apple Inc."
            android:textColor="@color/preview_dim"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="$231,45"
            android:textColor="@color/preview_on"
            android:textSize="14sp" />
        <TextView
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/preview_chip_down"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:text="−0,9%"
            android:textColor="@color/negative"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="5dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ASELS"
            android:textColor="@color/preview_on"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Aselsan"
            android:textColor="@color/preview_dim"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="₺182,40"
            android:textColor="@color/preview_on"
            android:textSize="14sp" />
        <TextView
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/preview_chip_flat"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:text="—"
            android:textColor="@color/preview_dim"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Takip"
            android:textColor="@color/preview_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="14:32"
            android:textColor="@color/preview_dim"
            android:textSize="12sp" />
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_refresh"
            android:tint="@color/preview_dim" />
    </LinearLayout>
</LinearLayout>
