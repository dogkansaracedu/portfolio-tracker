<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Portfoy" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:colorAccent">@color/brand_dark</item>
    </style>
    <style name="PrimaryButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:backgroundTint">?android:attr/colorAccent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
