# Copy to local.properties (gitignored). Values are baked into the APK via BuildConfig.
# SUPABASE_URL / SUPABASE_ANON_KEY are the public production values the PWA ships with
# (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY in the web app's .env.production.local).
sdk.dir=/Users/<you>/Library/Android/sdk
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
# Optional, defaults to the production PWA
PWA_URL=https://portfolio-tracker-theta-seven.vercel.app
